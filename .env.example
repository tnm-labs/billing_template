# Copy this file to .env for local runs. On Render/Railway/etc, set these
# as dashboard environment variables instead — do not upload .env itself.

# Required for AI auto-fill. Get one at https://console.anthropic.com
# (Settings -> API Keys). Usage is billed to this key, so keep it secret.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional. A current model ID from https://docs.claude.com/en/docs/about-claude/models
# Check that page before deploying in case this default has since been retired.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional but recommended for a public link: a shared passcode your team
# enters once in the page. Leave blank to disable the passcode screen.
ACCESS_CODE=

# Optional. Most hosts (Render, Railway, etc.) set this for you automatically.
PORT=3000

# ---- Google Sheets + Drive sync (see README "Setting up Google Sheets sync") ----

# Required for Sheet sync and PDF storage. The full JSON key of a Google
# service account, either pasted as-is (starts with "{") or base64-encoded
# (recommended — avoids env var newline issues; see README for the command).
GOOGLE_SERVICE_ACCOUNT_KEY=

# Required for Sheet sync. The Spreadsheet ID from your Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/PASTE_THIS_PART/edit
GOOGLE_SHEET_ID=

# Optional. Tab/sheet name to write into. Created if it doesn't exist is
# NOT automatic — use a tab name that already exists in your spreadsheet.
GOOGLE_SHEET_TAB=Invoices

# Required for PDF storage in Drive. The folder ID from a Google Drive
# folder's URL: https://drive.google.com/drive/folders/PASTE_THIS_PART
GOOGLE_DRIVE_FOLDER_ID=
